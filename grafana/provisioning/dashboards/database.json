        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "📊 Queries / sec",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "" },
